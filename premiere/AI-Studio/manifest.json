{
  "manifestVersion": 5,
  "id": "com.chaishots.aistudio",
  "name": "AI Studio",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "aiStudioPanel",
      "label": { "default": "AI Studio" },
      "minimumSize": { "width": 320, "height": 420 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 380, "height": 760 },
      "preferredFloatingSize": { "width": 400, "height": 780 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.png", "scale": [1, 2], "theme": ["all"] }
      ]
    }
  ],
  "icons": [
    { "width": 24, "height": 24, "path": "icons/plugin.png", "scale": [1, 2], "theme": ["all"], "species": ["pluginList"] }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "localFileSystem": "request",
    "clipboard": "readAndWrite",
    "launchProcess": { "schemes": ["https"], "extensions": [] }
  }
}
