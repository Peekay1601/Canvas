{
  "manifestVersion": 5,
  "id": "com.chaishots.ai-audio-studio",
  "name": "AI Audio Studio",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "aiAudioStudio",
      "label": { "default": "AI Audio Studio" },
      "minimumSize": { "width": 300, "height": 400 },
      "maximumSize": { "width": 2000, "height": 3000 },
      "preferredDockedSize": { "width": 360, "height": 640 },
      "preferredFloatingSize": { "width": 420, "height": 720 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/dark.png", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/light.png", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["https://api.elevenlabs.io", "https://api.anthropic.com"]
    },
    "localFileSystem": "fullAccess"
  }
}
